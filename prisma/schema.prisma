generator client {
  provider      = "prisma-client-js"
  // "native" couvre la machine de dev (Windows) et le build Docker/Railway (regénéré à
  // neuf dans l'image node:20-alpine à chaque build, donc toujours à jour indépendamment
  // de cette liste). "debian-openssl-3.0.x" est ajouté pour que les outils qui copient le
  // node_modules généré sur Windows tel quel dans un conteneur Linux glibc (ex. le bac à
  // sable Strix, basé sur Kali/Debian) trouvent un moteur utilisable sans regénération —
  // sans ce moteur, PrismaClient plante au démarrage avant même app.listen().
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model affiliate_clicks {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  affiliate_id String     @db.Uuid
  ip           String?
  user_agent   String?
  referer      String?
  created_at   DateTime   @default(now()) @db.Timestamptz(6)
  affiliates   affiliates @relation(fields: [affiliate_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([affiliate_id, created_at(sort: Desc)], map: "affiliate_clicks_aff_idx")
}

model affiliate_commissions {
  id                String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  affiliate_id      String     @db.Uuid
  telegram_id       String?    @db.Uuid
  filleul_email     String?
  type              String
  stripe_invoice_id String     @unique
  libelle           String?
  base_cents        Int
  devise            String     @default("EUR")
  taux              Decimal    @db.Decimal(5, 2)
  montant_cents     Int
  statut            String     @default("en_attente")
  fraude            Boolean    @default(false)
  periode           DateTime   @db.Date
  releve_id         String?    @db.Uuid
  created_at        DateTime   @default(now()) @db.Timestamptz(6)
  validee_le        DateTime?  @db.Timestamptz(6)
  payee_le          DateTime?  @db.Timestamptz(6)
  affiliates        affiliates @relation(fields: [affiliate_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([affiliate_id, periode(sort: Desc)], map: "affiliate_commissions_aff_idx")
  @@index([periode(sort: Desc)])
  @@index([statut])
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model affiliate_referrals {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  affiliate_id  String     @db.Uuid
  telegram_id   String?    @unique @db.Uuid
  email         String?
  statut        String     @default("active")
  expire_le     DateTime?  @db.Timestamptz(6)
  verrouille_le DateTime?  @db.Timestamptz(6)
  ip            String?
  created_at    DateTime   @default(now()) @db.Timestamptz(6)
  affiliates    affiliates @relation(fields: [affiliate_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users         users?     @relation(fields: [telegram_id], references: [telegram_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([affiliate_id], map: "affiliate_referrals_aff_idx")
}

model affiliate_statements {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  affiliate_id  String     @db.Uuid
  periode       DateTime   @db.Date
  devise        String     @default("EUR")
  montant_cents Int        @default(0)
  nb            Int        @default(0)
  statut        String     @default("a_facturer")
  created_at    DateTime   @default(now()) @db.Timestamptz(6)
  payee_le      DateTime?  @db.Timestamptz(6)
  affiliates    affiliates @relation(fields: [affiliate_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([affiliate_id, periode, devise])
