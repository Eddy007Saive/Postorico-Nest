/// Journal du cycle de vie d'un contenu (mémoire d'évaluation, hypothèse H2) : une ligne par
/// étape (genere, modifie, valide, refuse, publie). Table déjà présente en base ; ajoutée au
/// schéma le 2026-10-01 (introspection en retard, comme marques.typo_*).
model contenu_evenement {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contenu_id String   @db.Uuid
  type       String
  acteur     String?  @db.Uuid
  texte      String?
  created_at DateTime @default(now()) @db.Timestamptz(6)
}

model contenu_embeddings {
  contenu_id   String                @id @db.Uuid
  telegram_id  String                @db.Uuid
  genre        String
  reseau_cible String?
  texte        String
  embedding    Unsupported("vector")
  created_at   DateTime              @default(now()) @db.Timestamptz(6)
  contenu      contenu               @relation(fields: [contenu_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([embedding], map: "idx_contenu_embeddings_hnsw")
  @@index([telegram_id, genre], map: "idx_contenu_embeddings_user")
}

