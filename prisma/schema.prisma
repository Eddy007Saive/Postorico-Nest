model affiliates {
  id                    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  telegram_id           String?                 @db.Uuid
  code                  String                  @unique
  nom                   String
  email                 String
  statut                String                  @default("en_attente")
