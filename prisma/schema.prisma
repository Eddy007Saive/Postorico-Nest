/// Rico Coach : stats PAR POST et par réseau, collectées depuis Zernio (/v1/analytics) ;
/// totaux du mois dans stats_mensuelles. Migration _design/migrations/analytics_performance_par_post.sql.
/// taux_engagement (interactions / impressions, en %) est calculé par le code de collecte.
model analytics_performance {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contenu_id         String?   @db.Uuid
  zernio_id          String?   @unique(map: "analytics_performance_zernio_id")
  late_post_id       String?
  plateforme_post_id String?
  compte_id          String?
  reseau             String?
  format             String?
  publie_le          DateTime? @db.Timestamptz(6)
  impressions        Int       @default(0)
  portee             Int       @default(0)
  vues               Decimal?  @default(0) @db.Decimal
  likes              Decimal?  @default(0) @db.Decimal
  commentaires       Int?      @default(0)
  partages           Decimal?  @default(0) @db.Decimal
  enregistrements    Int       @default(0)
  clics              Int       @default(0)
  taux_engagement    Decimal?  @db.Decimal(6, 2)
  post_performant    Boolean?  @default(false)
  url                String?
  externe            Boolean   @default(false)
  details            Json      @default("{}")
  maj_zernio         DateTime? @db.Timestamptz(6)
  created_at         DateTime? @default(now()) @db.Timestamptz(6)
  updated_at         DateTime? @default(now()) @db.Timestamptz(6)
  telegram_id        String?   @db.Uuid
  contenu            contenu?  @relation(fields: [contenu_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users              users?    @relation(fields: [telegram_id], references: [telegram_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([late_post_id], map: "analytics_performance_late_post")
  @@index([telegram_id, publie_le(sort: Desc)], map: "analytics_performance_compte_date")
}

