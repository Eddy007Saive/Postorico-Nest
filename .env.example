# Environment variables for Postorico NestJS backend
# Copy this to .env and fill in the values

# Server
PORT=3000

# Database (Supabase)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Authentication
JWT_SECRET=

# CORS
CORS_ORIGINS=

# AI Services
API_CLAUDE= # or ANTHROPIC_API_KEY
CLAUDE_MODEL=
OPENROUTER_API_KEY=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Submagic
SUBMAGIC_API_KEY=
SUBMAGIC_DEFAULT_THEME_ID=

# HeyGen
HEYGEN_API_KEY=

# Resend (Email)
RESEND_API_KEY=
RESEND_FROM=
ADMIN_NOTIF_EMAIL=

# Late/Zernio (Social Publishing)
LATE_API_KEY=
LATE_API_BASE=
LATE_WEBHOOK_SECRET=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_PACK_EUR=
STRIPE_PRICE_PACK_USD=

# URLs
FRONTEND_URL=
BACKEND_URL=

# Newsletter (« La lettre de Rico »)
NEWSLETTER_CRON_ACTIVE=1 # 0 sur le backend dev (sinon dev et prod préparent chacun leur édition)
NEWSLETTER_JOUR=1 # 0=lundi … 6=dimanche (défaut mardi)
NEWSLETTER_HEURE=9 # heure locale (NEWSLETTER_TZ), fenêtre de 2h
NEWSLETTER_TZ=Europe/Paris
NEWSLETTER_PERPLEXITY_MODEL=perplexity/sonar-pro

# Cloudflare Turnstile (anti-bot, /audit-marque)
TURNSTILE_SECRET_KEY=

# Analytics
ANALYTICS_CRON_HOURS=1 # Hourly